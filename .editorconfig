[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Standard properties
end_of_line = native

[*.{c,cmake,cpp,cxx,h,hpp,hxx}]
indent_style = space
indent_size = 4

[*.reds]
indent_style = space
indent_size = 2

[*.xml]
indent_style = tab

[*.json]
indent_style = space
indent_size = 2
